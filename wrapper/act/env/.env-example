# Copy this file to '.env' (git-ignored) to override the defaults.

# Image the ubuntu-* jobs run in (default: ghcr.io/this-is-tobi/tools/act-runner:latest)
# ACT_RUNNER_IMAGE=

# Local registry (-r)
# The credentials have no default: the local registry refuses to start while they are empty.
REGISTRY_HOST=localhost:5555
REGISTRY_PORT=5555
REGISTRY_USERNAME=
REGISTRY_SECRET=
