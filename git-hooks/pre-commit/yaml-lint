#!/bin/bash

# Prerequisite :
#   - https://github.com/adrienverge/yamllint
#
# Lint the staged YAML files (*.yaml, *.yml, .yamllint) with yamllint.
#
# Environment:
#   YAMLLINT_CONFIG  yamllint config file (default: .yamllint, see
#                    git-hooks/configs/yamllint.yaml). When it is unset and
#                    .yamllint does not exist, yamllint looks up its config itself.
#
# The working tree copy of each staged file is linted: unstaged edits to a
# staged file are linted too.
#
# The checks run in a subshell so that, when several hooks are appended to the
# same pre-commit file, finishing early here never skips the hooks after it.
(
  set -uo pipefail

  cd "$(git rev-parse --show-toplevel)" || exit 1

  FILES=()
  while IFS= read -r -d '' FILE; do
    [ -f "$FILE" ] && FILES+=("$FILE")
  done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.yaml' '*.yml' '.yamllint' '*/.yamllint')

  if [ "${#FILES[@]}" -eq 0 ]; then
    echo "yaml-lint: no staged YAML file, skipped."
    exit 0
  fi

  if ! command -v yamllint > /dev/null 2>&1; then
    echo "yaml-lint: yamllint is not installed (https://github.com/adrienverge/yamllint). Install it, or skip the hook once with 'git commit --no-verify'." >&2
    exit 1
  fi

  CONFIG_PATH="${YAMLLINT_CONFIG:-.yamllint}"
  CONFIG_ARGS=()
  if [ -f "$CONFIG_PATH" ]; then
    CONFIG_ARGS=(--config-file "$CONFIG_PATH")
  elif [ -n "${YAMLLINT_CONFIG:-}" ]; then
    echo "yaml-lint: config file '$CONFIG_PATH' (YAMLLINT_CONFIG) not found." >&2
    exit 1
  fi

  # Check if yaml files respect linting rules
  # ${a[@]+...} because bash 3.2 treats an empty array as unbound under set -u
  yamllint ${CONFIG_ARGS[@]+"${CONFIG_ARGS[@]}"} -- "${FILES[@]}"
) || exit $?
